#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set cursorctl-dont-show-sync-warning 1
preferences set toolbar-Standard-WaveWindow {
  usual
  position -pos 1
}
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0

#
# Databases
#
array set dbNames ""
set dbNames(realName1) [ database require waves -hints {
	file ./waves.shm/waves.trn
	file /home/la_52/MLAB_MCU_edu/uvm/sim/waves.shm/waves.trn
}]
if {$dbNames(realName1) == ""} {
    set dbNames(realName1) waves
}
set dbNames(realName2) [ database require /home/la_52/MLAB_MCU_edu/uvm/sim/sim_build/xcelium.d/worklib/mcu/sv/debug_db/mcu/mcu.dsn -hints {
	file ./sim_build/xcelium.d/worklib/mcu/sv/debug_db/mcu/mcu.dsn
	file /home/la_52/MLAB_MCU_edu/uvm/sim/sim_build/xcelium.d/worklib/mcu/sv/debug_db/mcu/mcu.dsn
}]
if {$dbNames(realName2) == ""} {
    set dbNames(realName2) {"/home/la_52/MLAB_MCU_edu/uvm/sim/sim_build/xcelium.d/worklib/mcu/sv/debug_db/mcu/mcu.dsn"}
}
#
# Groups
#
catch {group new -name gpio -overlay 0}
catch {group new -name dmem -overlay 0}
catch {group new -name imem -overlay 0}
catch {group new -name sram1 -overlay 0}
catch {group new -name sram2 -overlay 0}
catch {group new -name gpio_ws -overlay 0}
catch {group new -name uart_ws -overlay 0}
catch {group new -name core -overlay 0}
group using gpio
group set -overlay 0
group set -comment {}
group clear 0 end

group using dmem
group set -overlay 0
group set -comment {}
group clear 0 end

group using imem
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    sram1 \
    sram2
group using sram1
group set -overlay 0
group set -comment {}
group clear 0 end

group using sram2
group set -overlay 0
group set -comment {}
group clear 0 end

group using gpio_ws
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_gpio.u_wb_gpio.ext_pad_s[9:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_gpio.u_wb_gpio.ext_pad_o[9:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_gpio.u_wb_gpio.ext_pad_i[9:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_gpio.u_wb_gpio.rgpio_oe_sel}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_gpio.u_wb_gpio.rgpio_ptrig[9:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_gpio.u_wb_gpio.rgpio_in[9:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_gpio.u_wb_gpio.rgpio_inte[9:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_gpio.u_wb_gpio.aux_i[9:0]}]} ]
group using uart_ws
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_uart.u_wb_uart.o_uart_tx}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_uart.u_wb_uart.i_uart_rx}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_uart.u_wb_uart.r_tx_data[7:0]}]} ]
group using core
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_wb_ibex_top.inst_ibex_top.u_ibex_core.pc_if[31:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_wb_ibex_top.inst_ibex_top.u_ibex_core.pc_id[31:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {mcu.top.u_wb_ibex_top.inst_ibex_top.u_ibex_core.instr_addr_o[31:0]}]} ]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {$dbNames(realName1)::[format {mcu.top.u_wb_ibex_top.inst_ibex_top.u_ibex_core}]} ]
browser set \
    -signalsort name
browser yview see [subst  {$dbNames(realName1)::[format {mcu.top.u_wb_ibex_top.inst_ibex_top.u_ibex_core}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1010x600+1043+465}] != ""} {
    window geometry "Waveform 1" 1010x600+1043+465
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ps \
    -valuewidth 75
waveform baseline set -time 1000ps

set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {mcu.top.clk_sys}]}
	} ]]

set groupId0 [waveform add -groups core]


set groupId0 [waveform add -groups gpio_ws]


set groupId0 [waveform add -groups uart_ws]


waveform xview limits 51433234ps 55090001ps

#
# Waveform Window Links
#

#
# Memory Viewer windows
#
if {[catch {window new MemViewer -name "Memory Viewer 1" -geometry 700x500+279+855}] != ""} {
    window geometry "Memory Viewer 1" 700x500+279+855
}
window target "Memory Viewer 1" on
memviewer using {Memory Viewer 1}
memviewer set \
-primarycursor TimeA \
-units ps \
-radix default \
-addressradix default \
-addressorder MSBtoLSB

memviewer sidebar visibility partial

#
# Console windows
#
console set -windowname Console
window geometry Console 730x250+261+564

